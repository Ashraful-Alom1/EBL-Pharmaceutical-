rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for optional authentication checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@easternbiochemicals[.]com')
      );
    }

    // =========================================================================
    // 1. PRODUCTS & MEDICINE CATALOG
    // Public read for customer storefront; write allowed for admin/store sync
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // 2. PHARMACEUTICAL CATEGORIES
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // 3. STOREFRONT VISUALS & BANNERS
    // =========================================================================
    match /storeVisuals/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // 4. BLOGS & HEALTHCARE ARTICLES
    // =========================================================================
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // 5. CUSTOMER REVIEWS
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // =========================================================================
    // 6. RETAIL CUSTOMER ORDERS
    // Anyone can place an order; reads & updates allowed for order fulfillment
    // =========================================================================
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 7. WHOLESALE DISTRIBUTORS (B2B DRUG LICENSE DIRECTORY)
    // =========================================================================
    match /wholesalers/{wholesalerId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 8. WHOLESALE ORDERS & CONSIGNMENT INVOICES
    // =========================================================================
    match /wholesaleOrders/{wholesaleOrderId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 9. FEFO INVENTORY BATCHES & EXPIRY LEDGERS
    // =========================================================================
    match /batches/{batchId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 10. OPERATING EXPENSES & FINANCIAL AUDIT
    // =========================================================================
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 11. INBOUND LEADS & CRM
    // =========================================================================
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 12. CAREERS & JOB APPLICATIONS
    // =========================================================================
    match /applications/{appId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 13. SYSTEM LEDGER (Consolidated Store Data for live dynamic updates)
    // =========================================================================
    match /system/{docId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 14. DEFAULT CATCH-ALL
    // =========================================================================
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
